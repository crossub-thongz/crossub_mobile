{
  "expo": {
    "name": "CROSSUB APP",
    "slug": "crossub-inspector",
    "owner": "crossub-property-management",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "crossubinspector",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.crossub.inspector",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleDisplayName": "CROSSUB\u00a0APP",
        "CFBundleName": "CROSSUB APP",
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "CROSSUB Inspector needs the camera to photograph inspection evidence.",
        "NSPhotoLibraryUsageDescription": "CROSSUB Inspector needs the photo library to attach inspection evidence."
      }
    },
    "android": {
      "label": "CROSSUB APP",
      "package": "com.crossub.inspector",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#2BB5A8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#2BB5A8",
          "dark": {
            "backgroundColor": "#2BB5A8"
          }
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "CROSSUB Inspector needs the camera to photograph inspection evidence.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "CROSSUB Inspector needs the photo library to attach inspection evidence."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CROSSUB Inspector uses your location to show nearby pool jobs and travel times."
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bdd9750e-e39f-4ef2-abbc-35f28c26e116"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/bdd9750e-e39f-4ef2-abbc-35f28c26e116"
    }
  }
}
