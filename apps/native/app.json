{
  "expo": {
    "name": "CROS Inspect",
    "slug": "crossub-inspector",
    "owner": "crossub-property-management",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "crossubinspector",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.crossub.inspector",
      "appleTeamId": "KQ997HDJ7H",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      },
      "associatedDomains": [
        "applinks:crossub-mobile-inspector.onrender.com",
        "applinks:crossub-mobile-inspector-prod.onrender.com"
      ],
      "infoPlist": {
        "CFBundleDisplayName": "CROS Inspect",
        "CFBundleName": "CROS Inspect",
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "CROSSUB Inspector needs the camera to photograph inspection evidence.",
        "NSPhotoLibraryUsageDescription": "CROSSUB Inspector needs the photo library to attach inspection evidence.",
        "NSPhotoLibraryAddUsageDescription": "CROSSUB Inspector saves inspection photos in your library only when you choose to.",
        "BGTaskSchedulerPermittedIdentifiers": ["com.crossub.inspector.photo-upload.batch"],
        "UIBackgroundModes": ["remote-notification"],
        "UIApplicationSceneManifest": {
          "UIApplicationSupportsMultipleScenes": false,
          "UISceneConfigurations": {
            "UIWindowSceneSessionRoleApplication": [
              {
                "UISceneConfigurationName": "Default Configuration",
                "UISceneDelegateClassName": "SceneDelegate"
              }
            ]
          }
        }
      }
    },
    "android": {
      "label": "CROS Inspect",
      "package": "com.crossub.inspector",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#041436",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "crossub-mobile-inspector.onrender.com",
              "pathPrefix": "/login"
            },
            {
              "scheme": "https",
              "host": "crossub-mobile-inspector.onrender.com",
              "pathPrefix": "/reset-password"
            },
            {
              "scheme": "https",
              "host": "crossub-mobile-inspector-prod.onrender.com",
              "pathPrefix": "/login"
            },
            {
              "scheme": "https",
              "host": "crossub-mobile-inspector-prod.onrender.com",
              "pathPrefix": "/reset-password"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/with-ios-scene-lifecycle.js",
      "expo-router",
      "expo-image",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#041436",
          "android": {
            "imageWidth": 176
          },
          "dark": {
            "backgroundColor": "#041436"
          }
        }
      ],
      "./plugins/with-android-splash-icon-background.js",
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "CROSSUB Inspector needs the camera to photograph inspection evidence.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "CROSSUB Inspector needs the photo library to attach inspection evidence."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CROSSUB Inspector uses your location to show nearby pool jobs and travel times."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#00EAEC",
          "sounds": [],
          "defaultChannel": "report-decisions"
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bdd9750e-e39f-4ef2-abbc-35f28c26e116"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/bdd9750e-e39f-4ef2-abbc-35f28c26e116"
    }
  }
}
