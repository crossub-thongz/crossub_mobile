{
  "name": "@crossub/inspector-native",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "private": true,
  "description": "CROSSUB inspector Expo app (iOS + Android). Consumes the same Nest API as the Next inspector portal.",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "eas-build-post-install": "pnpm --filter @crossub-thongz/api-contract build",
    "eas:preview": "npx eas-cli build --profile preview --platform all",
    "eas:production": "npx eas-cli build --profile production --platform all",
    "eas:submit": "npx eas-cli submit --profile production --platform all --latest"
  },
  "dependencies": {
    "@crossub-thongz/api-contract": "workspace:*",
    "@crossub/inspector-core": "workspace:*",
    "@expo/dom-webview": "~58.0.2",
    "@expo/metro-runtime": "~58.0.15",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native/metro-config": "0.88.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "expo": "~58.0.19",
    "expo-camera": "~58.0.12",
    "expo-constants": "~58.0.13",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.11",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.17",
    "expo-image-manipulator": "~58.0.15",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-location": "~58.0.19",
    "expo-network": "~58.0.4",
    "expo-notifications": "~58.1.6",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.20",
    "expo-splash-screen": "~58.0.11",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-updates": "~58.0.18",
    "expo-web-browser": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "~4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  }
}
