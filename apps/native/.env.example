# Nest API origin for the native app (no Next BFF). No trailing slash. Do not append /api.
# A physical phone cannot use localhost — that is the phone itself, not your Mac.
# Staging (recommended for Expo Go):
EXPO_PUBLIC_API_URL=https://crossub-api-staging.onrender.com
# Local API from iOS Simulator: http://localhost:3001
# Local API from a physical device: http://YOUR_MAC_LAN_IP:3001
# Production: https://crossub-api.onrender.com
