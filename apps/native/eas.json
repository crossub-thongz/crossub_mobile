{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote",
    "requireCommit": false
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      }
    },
    "staging": {
      "autoIncrement": true,
      "distribution": "store",
      "channel": "staging",
      "env": {
        "APP_VARIANT": "staging",
        "EXPO_PUBLIC_API_URL": "https://crossub-api-staging.onrender.com"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://crossub-api-prod.onrender.com"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "staging": {
      "ios": {
        "ascAppId": "6822973115",
        "appleTeamId": "KQ997HDJ7H",
        "companyName": "CROSSUB PROPERTY MANAGEMENT PTY LTD",
        "groups": ["Dev Test"]
      }
    },
    "preview": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    },
    "production": {
      "ios": {
        "ascAppId": "6812279119",
        "appleTeamId": "KQ997HDJ7H",
        "companyName": "CROSSUB PROPERTY MANAGEMENT PTY LTD",
        "groups": ["Dev Test"]
      },
      "android": {
        "track": "production",
        "releaseStatus": "completed"
      }
    }
  }
}
